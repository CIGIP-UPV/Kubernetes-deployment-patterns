            "spec": {
                "containers": [
                    {
                        "command": [
                            "sh",
                            "-c",
                            "set -e\nVERSION=\"1.0.0\"\n# Tarball at PVC root (NOT in /pvc/overlay/ subdir). Reason:\n# the nginx server mounts the PVC at /usr/share/nginx/html/overlay/,\n# so PVC-root tarballs become /overlay/{version}.tar in URLs and\n# the default nginx index.html stays intact (probes on / return 200).\nTARGET=/pvc/${VERSION}.tar\nTARGET_TMP=/pvc/${VERSION}.tar.tmp\nSOURCE=/opt/overlay\n\necho \"[installer] Carrier version: ${VERSION}\"\necho \"[installer] Source content:\"\nls -la ${SOURCE}/\n\n# Idempotency: if final tarball already exists, skip.\n# Atomic: tarball is created with .tmp suffix and renamed at end.\n# The runtime initContainer would never see a partial download.\nif [ -f \"${TARGET}\" ]; then\n  echo \"[installer] ${TARGET} already exists\"\n  echo \"[installer] Skipping creation (idempotent re-run)\"\n  echo \"[installer] Existing tarball size:\"\n  ls -lh \"${TARGET}\"\n  exit 0\nfi\n\n# Why tarball instead of cp directory:\n# The HF cache contains relative symlinks (snapshots/HASH/X →\n# ../../blobs/Y). nginx serves symlinks as their target's content,\n# so an init container using `wget -r` over HTTP would receive\n# the same blob bytes TWICE (once via snapshots/ path, once via\n# blobs/ path), turning a 17 GB overlay into a 30 GB on edge.\n# A tarball preserves symlinks faithfully and travels as a single\n# HTTP GET — faster, atomic, no duplication.\necho \"[installer] Creating tarball ${TARGET_TMP}...\"\necho \"[installer] (This will take a few minutes for ~17 GB)\"\ntar -cf \"${TARGET_TMP}\" -C ${SOURCE} .\necho \"[installer] Tarball created. Renaming atomically...\"\nmv \"${TARGET_TMP}\" \"${TARGET}\"\n\necho \"\"\necho \"[installer] Final tarball:\"\nls -lh \"${TARGET}\"\necho \"\"\necho \"[installer] PVC contents:\"\nls -la /pvc/\necho \"\"\necho \"[installer] PVC total usage:\"\ndu -sh /pvc/\n\necho \"[installer] Done.\"\n"
                        ],
