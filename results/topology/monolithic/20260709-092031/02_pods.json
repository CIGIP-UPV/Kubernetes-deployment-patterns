            "spec": {
                "containers": [
                    {
                        "args": [
                            "set -e\nsource /opt/ros/humble/setup.bash\nif [ -f /opt/ros2_monolithic_ws/install/setup.bash ]; then\n  source /opt/ros2_monolithic_ws/install/setup.bash\nfi\necho \"[monolithic] Starting camera node...\"\nros2 run camera_driver_pkg camera_driver --ros-args \\\n  -p device:=${CAMERA_DEVICE} \\\n  -p width:=${CAMERA_WIDTH} \\\n  -p height:=${CAMERA_HEIGHT} \\\n  -p fps:=${CAMERA_FPS} \\\n  -p frame_id:=${CAMERA_FRAME_ID} \\\n  -p synthetic_mode:=${CAMERA_SYNTHETIC_MODE} \\\n  -p image_topic:=${IMAGE_TOPIC} \u0026\nCAMERA_PID=$!\n\nsleep ${YOLO_START_DELAY}\necho \"[monolithic] Starting yolo node...\"\nros2 run yolo_detector_pkg yolo_detector --ros-args \\\n  -p model_path:=${YOLO_MODEL_PATH} \\\n  -p conf:=${YOLO_CONF} \\\n  -p image_topic:=${IMAGE_TOPIC} \\\n  -p detections_topic:=${DETECTIONS_TOPIC} \\\n  -p debug_image_topic:=${DEBUG_IMAGE_TOPIC} \\\n  -p publish_debug_image:=${YOLO_PUBLISH_DEBUG} \\\n  -p publish_metrics:=${YOLO_PUBLISH_METRICS} \\\n  -p latency_topic:=${LATENCY_TOPIC} \\\n  -p inference_topic:=${INFERENCE_TOPIC} \\\n  -p filter_classes:=\"\\\"${YOLO_FILTER_CLASSES}\\\"\" \u0026\nYOLO_PID=$!\n\necho \"[monolithic] Starting resource monitor...\"\npython3 /opt/scripts/resource_monitor.py \u0026\nRESMON_PID=$!\n\nif [ \"${LLAVA_ENABLED}\" = \"true\" ]; then\n  sleep ${LLAVA_START_DELAY}\n  echo \"[monolithic] Starting LLaVA reasoning node...\"\n  ros2 run llava_pkg llava_node --ros-args \\\n    -p model_id:=${LLAVA_MODEL_ID} \\\n    -p image_topic:=${IMAGE_TOPIC} \\\n    -p detection_topic:=${DETECTIONS_TOPIC} \\\n    -p trigger_topic:=${LLAVA_TRIGGER_TOPIC} \\\n    -p response_topic:=${LLAVA_RESPONSE_TOPIC} \\\n    -p latency_topic:=${LLAVA_LATENCY_TOPIC} \\\n    -p inference_topic:=${LLAVA_INFERENCE_TOPIC} \\\n    -p trigger_on_yolo:=${LLAVA_TRIGGER_ON_YOLO} \\\n    -p yolo_trigger_interval_s:=$(printf \"%.1f\" \"${LLAVA_YOLO_INTERVAL_S}\") \\\n    -p max_new_tokens:=${LLAVA_MAX_TOKENS} \\\n    -p load_in_4bit:=${LLAVA_LOAD_4BIT} \u0026\n  LLAVA_PID=$!\nfi\n\nif [ \"${VOXTRAL_ENABLED}\" = \"true\" ]; then\n  echo \"[monolithic] Starting Voxtral interaction node...\"\n  ros2 run voxtral_pkg voxtral_node --ros-args \\\n    -p audio_mode:=${VOXTRAL_AUDIO_MODE} \\\n    -p model_id:=${VOXTRAL_MODEL_ID} \\\n    -p command_topic:=${VOICE_COMMAND_TOPIC} \\\n    -p transcript_topic:=${VOICE_TRANSCRIPT_TOPIC} \\\n    -p response_topic:=${VOICE_RESPONSE_TOPIC} \\\n    -p llava_trigger_topic:=${LLAVA_TRIGGER_TOPIC} \\\n    -p llava_response_topic:=${LLAVA_RESPONSE_TOPIC} \\\n    -p latency_topic:=${VOICE_LATENCY_TOPIC} \u0026\n  VOXTRAL_PID=$!\nfi\n\nwait -n ${CAMERA_PID} ${YOLO_PID} ${RESMON_PID} ${LLAVA_PID:-} ${VOXTRAL_PID:-}\nexit 1\n"
                        ],
